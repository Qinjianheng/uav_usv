<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="default">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.35 0.45 0.55 1</ambient>
      <background>0.45 0.68 0.90 1</background>
      <shadows>true</shadows>
    </scene>

    <!--
      Visual-only sea surface. It is rendered by RGB and depth cameras but
      deliberately has no collision geometry, so the UAV does not strike a
      rigid ground plane at the virtual interception point.
    -->
    <model name="ocean_surface">
      <static>true</static>
      <pose>0 0 -0.02 0 0 0</pose>
      <link name="surface_link">
        <visual name="ocean_visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.02 0.12 0.22 1</ambient>
            <diffuse>0.03 0.28 0.50 1</diffuse>
            <specular>0.80 0.85 0.95 1</specular>
            <shininess>80</shininess>
          </material>
        </visual>
      </link>
    </model>

    <!-- The only rigid surface is a small pad under the initial UAV pose. -->
    <model name="takeoff_platform">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="platform_link">
        <collision name="platform_collision">
          <geometry>
            <box>
              <size>3 3 0.1</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="platform_visual">
          <geometry>
            <box>
              <size>3 3 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.18 0.18 0.20 1</ambient>
            <diffuse>0.28 0.28 0.32 1</diffuse>
            <specular>0.10 0.10 0.10 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>
